module ula_pc (entrada1, saida_pc, clk, pulso_fim);
input [31:0] entrada1;
output reg [31:0] saida_pc;
output reg pulso_fim;
reg [1:0] contador = 1;
input clk;

always @(posedge clk)
begin
if(contador==2)
begin
saida_pc <= entrada1 + 1;
contador <= 1;
pulso_fim <= 1'b1;   // pulsa 1 exatamente no ciclo em que a instrucao "fecha"
end
else
begin
contador <= contador + 1;
pulso_fim <= 1'b0;
end
end
endmodule